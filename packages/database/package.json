{
  "name": "@launchtic/database",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall":    "dotenv -e ../../.env -- prisma generate || prisma generate",
    "db:generate":    "dotenv -e ../../.env -- prisma generate",
    "db:migrate":     "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:prod":"dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio":      "dotenv -e ../../.env -- prisma studio",
    "db:seed":        "dotenv -e ../../.env -- tsx src/seed.ts",
    "db:seed:perf":   "dotenv -e ../../.env -- tsx src/seed-perf.ts",
    "db:seed:clean":  "dotenv -e ../../.env -- tsx src/seed-perf.ts --clean",
    "db:reset":       "dotenv -e ../../.env -- prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
