// ─────────────────────────────────────────
// WORKFLOWS  — graph-based automation (Phase 1 refactor)
// ─────────────────────────────────────────
//
// A Workflow is a directed graph of Nodes connected by Edges. Each WorkflowRun
// is a state machine that walks the graph one node at a time — the worker
// executes a node, then schedules the next node (immediate or delayed).
//
// Stored as JSON so the visual builder can write arbitrary positions / labels
// without schema churn. Node + edge SHAPES are documented in the executor
// (apps/worker/src/queues/workflow.ts).
//
// Sole automation primitive after Phase 1C — replaced legacy Automation +
// EmailSequence + ContactSequenceEnrollment in one drop.

model Workflow {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)

  // Trigger — new types added in Phase 2 (CHECKOUT_STARTED, PAGE_VISITED, etc.)
  // Stored as string (no enum) for forward extensibility without migrations.
  triggerType   String
  triggerConfig Json? // { funnelId?, funnelStepId?, tagId?, amountMin?, ... }

  // Graph definition. See WorkflowNode + WorkflowEdge types in the executor.
  //   nodes: [{ id, type, position: {x,y}, config }]
  //   edges: [{ id, source, target, label?, condition? }]
  nodes       Json
  edges       Json
  // Entry point — node id where every run starts. Validated on activate.
  startNodeId String?

  // Re-fire policy:
  //   "every" → fire on every event (default for transactional triggers).
  //             A SINGLE_ACTIVE guard still blocks concurrent runs (won't
  //             enroll the same contact while their previous run is still
  //             ACTIVE), but after COMPLETED the contact can re-enroll.
  //   "once"  → fire ONCE per contact ever. Block enroll if ANY previous
  //             run exists for this (workflow, contact) regardless of
  //             status. Used for welcome / lead magnet flows where
  //             re-firing on every event would spam the contact.
  // Per-trigger smart defaults: FORM_SUBMIT → "once" (welcome / opt-in
  // pattern), everything else → "every". See TRIGGER_DEFAULT_REFIRE_POLICY
  // in apps/web/lib/workflow-validation.ts.
  reFirePolicy    String @default("every")
  maxDurationDays Int?

  // Denormalized stats (incremented at run creation / completion). Source of
  // truth still WorkflowRun count queries.
  totalEnrolled   Int       @default(0)
  activeCount     Int       @default(0)
  completedCount  Int       @default(0)
  exitedCount     Int       @default(0)
  failedCount     Int       @default(0)
  lastTriggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]
  emails    WorkflowEmail[]

  @@index([workspaceId, status, triggerType])
  @@index([workspaceId, createdAt])
}

// ─────────────────────────────────────────
// WORKFLOW EMAIL — first-class content for SEND_EMAIL nodes
// ─────────────────────────────────────────
//
// Each SEND_EMAIL node in workflow.nodes JSON references a WorkflowEmail by
// `config.emailId`. The content (subject / body / sender) lives in this row
// instead of inline in the workflow JSON. Benefits:
//   - Per-email analytics: open/click rates aggregated cleanly per row
//   - Source-scoped conditions: `email_opened` can target a specific
//     WorkflowEmail via EmailSend.workflowEmailId
//   - Reusable across nodes in the same workflow (1 email can be wired
//     into multiple SEND_EMAIL nodes if the operator wants)
//   - Independent edit lifecycle: tweak copy without bumping the workflow
//     graph version
//
// Each WorkflowEmail is scoped to a single Workflow (workflowId required).
// Cross-workflow sharing would require promoting to workspace-scoped — a
// Phase 3+ feature when there's demand.

model WorkflowEmail {
  id          String @id @default(cuid())
  workspaceId String
  workflowId  String

  // Internal label for the operator's email list view. Falls back to
  // subject when empty in the UI.
  name String?

  // Content snapshot. Mustache vars resolved at send time by the worker.
  subject   String
  bodyHtml  String  @db.Text
  fromName  String
  fromEmail String
  senderId  String?

  // Denormalized counters bumped by the email worker / tracking endpoints.
  // Source of truth still EmailSend queries; these are for dashboard reads.
  sentCount    Int @default(0)
  openedCount  Int @default(0)
  clickedCount Int @default(0)
  failedCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // No `sends EmailSend[]` back-relation under Pattern B. Query with
  // `db.emailSend.findMany({ where: { sourceType: "WORKFLOW", sourceId: workflowEmailId } })`.

  @@index([workspaceId])
  @@index([workflowId])
}

model WorkflowRun {
  id          String            @id @default(cuid())
  workflowId  String
  workspaceId String
  contactId   String?
  status      WorkflowRunStatus @default(ACTIVE)

  // State-machine pointer. Null when run hasn't started OR has completed.
  currentNodeId String?

  // Scheduled execution time for the NEXT node. Used for delay nodes — the
  // worker poller picks runs with `status=ACTIVE AND scheduledFor <= now()`
  // and resumes them. Cleared once node is being executed.
  scheduledFor DateTime?

  // Trigger payload (immutable) + accumulated context (mutable across nodes).
  triggerData Json @default("{}")
  context     Json @default("{}")

  // Lifecycle. exitReason: "goal" | "manual" | "max_duration" | "workflow_paused"
  //                       | "workflow_deleted" | "re_enroll_blocked" | etc.
  exitReason  String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  steps     WorkflowRunStep[]

  @@index([workflowId, status])
  @@index([workspaceId, status])
  @@index([contactId])
  // Cron-style poller picks due runs from this index.
  @@index([status, scheduledFor])
}

model WorkflowRunStep {
  id       String @id @default(cuid())
  runId    String
  // Refers to Workflow.nodes[].id. Denormalized for fast filtering without
  // parsing the parent workflow JSON.
  nodeId   String
  nodeType String

  status String // PENDING | RUNNING | COMPLETED | FAILED | SKIPPED

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?   @db.Text
  // Per-step output (e.g. EmailSend.id, webhook response status). Indexed by
  // node id so the UI can render the step inside its node card.
  output      Json?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, startedAt])
  @@index([runId, nodeId])
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowRunStatus {
  ACTIVE // executing or scheduled for next node
  COMPLETED // reached an END node
  EXITED // exited via goal / manual / re-enroll / pause
  FAILED // unrecoverable error mid-run
}

// ─────────────────────────────────────────

// ─────────────────────────────────────────
// SYSTEM CONFIG  — singleton row, instance-wide settings
// ─────────────────────────────────────────
//
// First-run wizard writes here after the operator picks dashboard + pages
// domains in the browser (no env vars required pre-install). Apps + Caddy
// read from here at runtime: apps via SystemConfigService helper, Caddy via
// admin API call from the wizard.
//
// Id is hardcoded to "system" — there is exactly one row per instance.
// Pre-setup state = no row exists OR setupCompletedAt is null → middleware
// redirects every request to /setup.
model SystemConfig {
  id               String    @id @default("system")
  appDomain        String?
  pagesDomain      String?
  acmeEmail        String?
  // Marks the wizard as finished. Apps gate first-run redirects on this —
  // a row with this null means setup was started but never completed (e.g.
  // browser tab closed mid-flow) and the wizard should resume from Step 2.
  setupCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
