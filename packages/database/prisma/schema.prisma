generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// env file: packages/database reads from ../../.env (root)

// ─────────────────────────────────────────
// AUTH & MULTI-TENANCY
// ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // The Organization this User owns (founder of the install). Only the user
  // who registered first ever owns an Organization on self-host (register
  // endpoint is locked down after the first signup). Team members invited
  // via /api/team have ownedOrganization = null — they're WorkspaceMembers
  // only, not Organization owners.
  ownedOrganization   Organization?
  ownedWorkspaces     Workspace[]
  memberships         WorkspaceMember[]
  passwordResetTokens PasswordResetToken[]
  refundedOrders      Order[]              @relation("OrderRefundedBy")
  contactNotes        ContactNote[]
}

// The billing/org entity. Source of truth for plan + license. On self-host
// there is exactly one Organization per instance (founder owns it; team
// members access its workspaces via WorkspaceMember). Permission checks
// read plan from the workspace's Organization — not from the logged-in
// User — so an invited team member working inside an Agency workspace gets
// full Agency features.
//
// SaaS-ready: when launchtic launches a hosted mode, removing the register
// lockdown lets each signup auto-create their own Organization (Slack/Linear
// pattern). Adding Stripe fields (stripeCustomerId, stripeSubscriptionId) or
// OrganizationMember/OrganizationInvite tables later is purely additive —
// no migration of existing rows required.
model Organization {
  id   String @id @default(cuid())
  name String

  // Plan + license. NULL = FREE tier (default — no license needed). Only
  // AGENCY/CUSTOM require a license; reVerifyIfStale sets plan back to NULL
  // (i.e. downgrades to FREE) if the license server revokes or the Agency
  // subscription lapses.
  plan              Plan?
  licenseKey        String?
  licenseExpiresAt  DateTime?
  licenseVerifiedAt DateTime?
  // Stable per-install ID sent with license verify so the license server can
  // detect key sharing across installations.
  instanceId        String?
  // Purchased product keys (template packs…) entered under Settings → License.
  // Their files are listed + downloaded from the license server on demand.
  productKeys       String[]  @default([])

  // White-label branding overrides (Agency/Custom tier only). JSON shape:
  // Null/empty fields fall back to launchtic defaults. Gated at write time by
  // PLAN_FEATURES[plan].whiteLabel — runtime reads always succeed (so a
  // downgraded plan still renders the agency's saved branding rather than
  // snapping back to launchtic mid-session; the next save will be blocked).
  brandingConfig Json?

  // Storage config shared by every Workspace under this Organization.
  // Shape: { driver, endpoint, region, bucket, accessKey, secretKey, publicUrl }
  // Owner-managed via Settings UI. secretKey is stored plaintext (same
  // pattern as stripe.secretKey / ai.apiKey on WorkspaceSettings).
  // Files are isolated per-workspace via the {workspaceId}/... path prefix,
  // so a single bucket safely hosts all workspaces. Resolution priority at
  // runtime (see lib/storage.ts):
  //   1. Organization.storage — owner-managed via Settings UI (this column)
  //   2. WorkspaceSettings.storage — legacy per-workspace fallback
  //   3. Local driver — default
  storage Json?

  // Founder — primary admin and (for now) the only user who can manage this
  // Organization's billing. Unique today because B-minimal is single-owner;
  // drop the unique constraint + add OrganizationMember when multi-owner is
  // needed (additive, no data loss).
  ownerId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces Workspace[]
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  ownerId        String
  // Billing parent. Inherited from owner's Organization at create time —
  // never changes for a given Workspace. Plan/license checks for this
  // workspace read from organization.plan.
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User              @relation(fields: [ownerId], references: [id])
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]

  funnels          Funnel[]
  contacts         Contact[]
  tags             Tag[]
  physicalProducts PhysicalProduct[]
  domains          Domain[]
  settings         WorkspaceSettings?
  orders           Order[]
  subscriptions    Subscription[]
  coupons          Coupon[]
  emailTemplates   EmailTemplate[]
  broadcasts       Broadcast[]
  emailSends       EmailSend[]
  workflows        Workflow[]
  workflowRuns     WorkflowRun[]
  senderIdentities SenderIdentity[]
  aiConversations  AiConversation[]
  savedBlocks      SavedBlock[]
  pageTemplates    PageTemplate[]
  roles            Role[]
  assets           Asset[]
  pipelines        Pipeline[]

  @@index([organizationId])
}

// Per-workspace media library. Every uploaded file is tracked here so that
// content can reference assets by id (portable across storage drivers, domain
// changes, clone, and marketplace import) while still keeping `url` denormalized
// for fast render. `sha256` enables dedup at upload time and during clone/import.
model Asset {
  id          String @id @default(cuid())
  workspaceId String
  filename    String
  mimeType    String
  sha256      String
  bytes       Int
  width       Int?
  height      Int?
  // Internal storage key (driver-relative, no host). Used by migration tools
  // that read the file via the driver that wrote it.
  storagePath String
  // Public URL resolved at upload time and persisted. Render reads this
  // directly — no driver call needed at render. Storage migration is the
  // only event that requires rewriting this field.
  url         String
  // Small WebP for media-library grids (or `url` itself when the original is
  // already small / SVG). Null = not generated yet; filled lazily on listing.
  thumbUrl    String?
  // Which driver wrote this file. Lets a mixed-storage workspace (some files
  // on local, some on S3 after a switch) read each file with the right driver.
  driver      String

  // Pinned to the top of the Media Library. Per workspace (the whole team
  // shares the same pins). Toggled via /api/media/pin.
  pinned      Boolean @default(false)

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sha256])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, pinned])
}

// One-time tokens for the "forgot password" flow. Token itself is never
// stored — only its SHA-256 hash. The raw token lives in the reset email
// link and the user's clipboard for the duration of the flow.
//   - expiresAt: 1 hour from creation
//   - usedAt:    set when the user successfully resets via this token
// On successful reset, all other tokens for the same user are deleted to
// invalidate concurrent attempts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  // Role driving permission gates. References a Role row in the same
  // workspace. Founder (Organization.ownerId) bypasses this check via the
  // OWNER shortcut in requireAccess — so the founder's actual roleId here
  // doesn't determine their permissions (typically set to "Admin" anyway).
  roleId      String
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([workspaceId, userId])
  @@index([roleId])
}

// Role = permission preset, scoped per Workspace. Every workspace gets 4
// defaults seeded at creation (Admin, Marketer, Designer, Viewer) — all
// editable/deletable by users with `roles:manage`. Custom roles can be
// created on top.
//
// OWNER is NOT a role here — it's derived from Organization.ownerId and
// short-circuits the permission check in requireAccess. So this table only
// holds non-owner roles.
//
// Permissions stored as text[] for native Postgres @> / ANY support and
// easy JSON serialization to the client.
model Role {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ─────────────────────────────────────────
// DOMAINS
// ─────────────────────────────────────────

model Domain {
  id          String   @id @default(cuid())
  workspaceId String
  domain      String   @unique
  verified    Boolean  @default(false)
  // The PAGES_DOMAIN configured at install time — exactly one Domain per
  // workspace is flagged isDefault=true. Funnels without explicit FunnelDomain
  // assignments are served on this domain. Custom domains use isDefault=false
  // and require FunnelDomain entries to be reachable.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  funnelDomains FunnelDomain[]
}

// Junction: multiple funnels can share a single domain
// Unique: domain + slug (enforced at app level)
model FunnelDomain {
  funnelId  String
  domainId  String
  createdAt DateTime @default(now())

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([funnelId, domainId])
  @@index([domainId])
}

// ─────────────────────────────────────────
// FUNNELS & PAGES
// ─────────────────────────────────────────

model Funnel {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  currency    String       @default("usd")
  favicon     String?
  status      FunnelStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps     FunnelStep[]
  domains   FunnelDomain[]
  events    FunnelEvent[]

  @@index([workspaceId, status])
}

model FunnelStep {
  id       String   @id @default(cuid())
  funnelId String
  name     String
  slug     String
  type     StepType
  order    Int

  // Offer config (only meaningful for CHECKOUT / UPSELL / DOWNSELL)
  offerType         OfferType?
  physicalProductId String?
  shippingFee       Int        @default(0) // cents
  couponIds         String[]   @default([])

  // One-click upsell/downsell branching: which step to route to after the
  // visitor accepts (buys) vs declines this step. Null → fall back to the next
  // step by `order`. Plain ids (no FK) — navigation resolves + validates them.
  acceptStepId  String?
  declineStepId String?

  // Craft.js JSON — stored as JSONB
  pageJson Json

  // SEO + Tracking metadata
  meta Json?

  // A/B testing. When true, the renderer serves a StepVariant (chosen per
  // visitor by weight) instead of `pageJson`. Starting a test snapshots the
  // current pageJson into a control StepVariant; promoting a winner copies it
  // back into pageJson and clears variants + this flag.
  abTestActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funnel          Funnel               @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  physicalProduct PhysicalProduct?     @relation(fields: [physicalProductId], references: [id])
  pricePlans      StepPricePlan[]
  orders          Order[]
  subscriptions   Subscription[]
  resources       FunnelStepResource[]
  orderBumps      OrderBump[]
  variants        StepVariant[]

  @@unique([funnelId, slug])
  @@index([funnelId, order])
}

// An A/B test variant of a FunnelStep. The control variant (isControl=true) is
// a snapshot of the step's pageJson at test start; other rows are challengers.
// The renderer picks one per visitor by `weight` (deterministic on sessionId,
// so a visitor sticks to the same variant), and FunnelEvent.variantId carries
// the assignment for per-variant analytics.
model StepVariant {
  id        String   @id @default(cuid())
  stepId    String
  name      String // "Control", "Variant B", "New headline"
  pageJson  Json
  weight    Int      @default(50) // relative traffic split
  isControl Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  step FunnelStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

// Append-only analytics event log. One row per visitor action in a funnel:
//   VIEW     — a funnel step page was served
//   LEAD     — an opt-in form was submitted
//   PURCHASE — an order was paid (amountCents + orderId set)
// Powers Funnel Analytics (aggregate by step/date) and, later, A/B testing
// (group by variantId). Separate from ContactEvent (CRM timeline) because
// VIEWs are anonymous (no contact) and we need sessionId + variant attribution.
model FunnelEvent {
  id          String          @id @default(cuid())
  funnelId    String
  stepId      String
  type        FunnelEventType
  // Per-visitor id from the lt_sid cookie set by the renderer — stitches a
  // visitor's journey across steps and is the unit of A/B attribution.
  sessionId   String
  variantId   String? // set once A/B testing ships; null today
  contactId   String? // LEAD / PURCHASE once identified
  orderId     String? // PURCHASE only
  amountCents Int? // PURCHASE only — for revenue rollups
  ip          String?
  createdAt   DateTime        @default(now())

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId, type, createdAt])
  @@index([stepId, variantId])
  @@index([sessionId])
}

enum FunnelEventType {
  VIEW
  LEAD
  PURCHASE
}

model PageTemplate {
  id           String   @id @default(cuid())
  // Workspace owner. Templates are workspace-scoped: each workspace has its
  // own copy (seeded on register from packages/database/src/seed-data/).
  workspaceId  String
  name         String
  thumbnailUrl String?
  type         StepType
  // The AI picks templates from a summary read from pageJson itself
  // (apps/web/lib/page-templates/summarize.ts) — no hand-written tags.
  pageJson     Json     @default("{}")
  // Page-level metadata mirroring FunnelStep.meta — { seo, tracking, font, ... }.
  // Cloned onto a FunnelStep when the template is applied so things like the
  // page-default font carry over to new pages.
  meta         Json     @default("{}")
  // When set, this template is auto-selected for new steps of `type` (e.g.
  // when AI assistant scaffolds a funnel). Only one template per type should
  // be marked default; app-level enforcement (no DB partial-unique).
  isDefault    Boolean  @default(false)
  // Inactive templates are hidden from the template picker but kept in the
  // admin list so they can be re-enabled or referenced for cloning.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, isDefault])
  @@index([workspaceId])
  @@index([isActive])
}

// User-saved reusable blocks (Section / Row subtree from the editor).
// Scoped per workspace — shared across team members.
model SavedBlock {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  kind        String // 'section' | 'row'
  tags        String[] @default([])
  contentJson Json // serialized Craft.js node tree
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@index([workspaceId, createdAt])
}

// ─────────────────────────────────────────
// PRODUCTS & PRICING
// ─────────────────────────────────────────

// Physical product catalog (SKU, inventory, shipping)
model PhysicalProduct {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  sku         String?
  price       Int      @default(0) // cents — reference/base price
  currency    String   @default("usd")
  weight      Float? // grams
  limitStock  Boolean  @default(false)
  stockLimit  Int?
  images      String[]
  hasOptions  Boolean  @default(false)
  options     Json? // [{ id, name, values: string[] }]
  variants    Json? // [{ id, name, combination: string[], sku, price (cents|null), image }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  funnelSteps FunnelStep[]
  orderBumps  OrderBump[]
}

// Price plans inline per funnel step — no shared catalog
model StepPricePlan {
  id            String    @id @default(cuid())
  funnelStepId  String
  name          String
  description   String?
  type          PriceType
  amount        Int // cents
  currency      String    @default("usd")
  interval      String? // month | year (SUBSCRIPTION only)
  trialDays     Int? // SUBSCRIPTION trial period in days
  stripePriceId String? // cached Stripe Price ID
  paypalPlanId  String? // cached PayPal Billing Plan ID
  createdAt     DateTime  @default(now())

  funnelStep    FunnelStep     @relation(fields: [funnelStepId], references: [id], onDelete: Cascade)
  orders        Order[]
  subscriptions Subscription[]
}

// Order bumps — add-on offers shown at checkout
model OrderBump {
  id                String     @id @default(cuid())
  funnelStepId      String
  label             String
  headline          String?
  offerType         OfferType?
  physicalProductId String?
  shippingFee       Int        @default(0) // cents
  order             Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  funnelStep      FunnelStep           @relation(fields: [funnelStepId], references: [id], onDelete: Cascade)
  physicalProduct PhysicalProduct?     @relation(fields: [physicalProductId], references: [id])
  pricePlans      OrderBumpPricePlan[]
  resources       OrderBumpResource[]

  @@index([funnelStepId, order])
}

model OrderBumpPricePlan {
  id            String    @id @default(cuid())
  orderBumpId   String
  name          String
  description   String?
  type          PriceType
  amount        Int // cents
  currency      String    @default("usd")
  interval      String? // month | year (SUBSCRIPTION only)
  trialDays     Int?
  stripePriceId String?
  paypalPlanId  String? // cached PayPal Billing Plan ID
  createdAt     DateTime  @default(now())

  orderBump     OrderBump      @relation(fields: [orderBumpId], references: [id], onDelete: Cascade)
  orders        Order[]
  subscriptions Subscription[]
}

model OrderBumpResource {
  id          String       @id @default(cuid())
  orderBumpId String
  type        ResourceType
  resourceId  String
  createdAt   DateTime     @default(now())

  orderBump OrderBump @relation(fields: [orderBumpId], references: [id], onDelete: Cascade)

  @@unique([orderBumpId, type, resourceId])
  @@index([type, resourceId])
}

// ─────────────────────────────────────────
// CONTACTS & CRM
// ─────────────────────────────────────────

model Contact {
  id                  String  @id @default(cuid())
  workspaceId         String
  email               String
  firstName           String?
  lastName            String?
  phone               String?
  country             String?
  streetAddress       String?
  streetNumber        String?
  neighborhood        String?
  postalCode          String?
  city                String?
  state               String?
  company             String?
  taxNumber           String?
  language            String? @default("en")
  ip                  String?
  customFields        Json?
  providerCustomerIds Json? // { stripe: { usd: "cus_xxx", jpy: "cus_yyy" }, paypal: "PAYPAL-xxx" } — Stripe is per-currency (Customer is currency-pinned at first charge)

  // Email & GDPR
  consentedAt    DateTime?
  consentSource  String? // "form" | "import" | "manual" | "purchase"
  unsubscribedAt DateTime?
  bouncedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags             ContactTag[]
  events           ContactEvent[]
  orders           Order[]
  subscriptions    Subscription[]
  resourceAccesses ContactResourceAccess[]
  emailSends       EmailSend[]
  workflowRuns     WorkflowRun[]
  pipelineCards    PipelineCard[]
  notes            ContactNote[]

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
}

// ─────────────────────────────────────────
// CRM PIPELINES (Kanban)
// ─────────────────────────────────────────

// A pipeline is a Kanban board (e.g. "Sales") owned by a workspace. It holds
// ordered stages; a contact sits on exactly one stage of a given pipeline via
// a PipelineCard. A contact may appear on multiple pipelines at once.
model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  position    Int      @default(0) // order among the workspace's pipelines
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]

  @@index([workspaceId, position])
}

model PipelineStage {
  id         String  @id @default(cuid())
  pipelineId String
  name       String
  position   Int // column order, left → right
  color      String?

  pipeline Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  cards    PipelineCard[]

  @@index([pipelineId, position])
}

// One contact placed on one stage. Unique per (stage, contact) so the same
// contact can't be duplicated within a column. position orders cards top→bottom.
model PipelineCard {
  id        String   @id @default(cuid())
  stageId   String
  contactId String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([stageId, contactId])
  @@index([stageId, position])
  @@index([contactId])
}

// Free-text notes a team member writes on a contact (distinct from the
// automated ContactEvent timeline). Edited in the contact record.
model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  authorId  String? // User who wrote it; null if author deleted
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
}

model Tag {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  color       String?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([workspaceId, name])
}

model ContactTag {
  contactId String
  tagId     String
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

// Behavior timeline — the largest table in the system
model ContactEvent {
  id        String    @id @default(cuid())
  contactId String
  type      EventType
  data      Json?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([type, createdAt])
}

// ─────────────────────────────────────────
// ORDERS & TRANSACTIONS
// ─────────────────────────────────────────

model Order {
  id                   String  @id @default(cuid())
  workspaceId          String
  contactId            String
  funnelStepId         String?
  stepPricePlanId      String?
  orderBumpPricePlanId String? // set when the order originates from a bump
  subscriptionId       String?
  // Set when this order IS an upsell/downsell purchase — points at the main
  // step Order that visitor bought first. Drives dashboard grouping + refund
  // cascading. SetNull on parent delete so a child order survives independently.
  parentOrderId        String?
  physicalProductId    String?
  variantId            String?
  quantity             Int     @default(1)
  couponCode           String?
  orderItemSnapshot    Json? // snapshot of product/variant/plan at time of order
  bumpItems            Json? // ONE_TIME bump line items merged into this order

  status          OrderStatus
  paymentProvider String      @default("stripe") // stripe | paypal
  paymentMethod   String?

  // Provider-agnostic order/intent reference
  providerOrderId String? // PaymentIntent ID or PayPal order ID
  paymentMethodId String? // saved for 1-click upsells
  invoiceId       String? // Stripe invoice ID for subscription renewals
  isRenewal       Boolean @default(false)

  // Financials
  subtotal       Int // cents, before discount
  discountAmount Int    @default(0)
  shippingFee    Int    @default(0)
  total          Int // cents, final charged
  currency       String

  // Refund tracking
  refundAmount     Int       @default(0) // cents, cumulative refunded
  refundedAt       DateTime?
  refundedByUserId String?

  // Snapshot & shipping
  contactSnapshot Json? // name/email at time of purchase
  shippingAddress Json? // { line1, city, state, postal_code, country }

  // Raw gateway response
  gatewayData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact            Contact                 @relation(fields: [contactId], references: [id])
  funnelStep         FunnelStep?             @relation(fields: [funnelStepId], references: [id])
  // SetNull: merchant can hard-delete a plan after orders have referenced it —
  // orderItemSnapshot/bumpItems preserve everything needed for invoice / refund /
  // analytics, so the row link itself is non-essential.
  stepPricePlan      StepPricePlan?          @relation(fields: [stepPricePlanId], references: [id], onDelete: SetNull)
  orderBumpPricePlan OrderBumpPricePlan?     @relation(fields: [orderBumpPricePlanId], references: [id], onDelete: SetNull)
  subscription       Subscription?           @relation(fields: [subscriptionId], references: [id])
  refundedBy         User?                   @relation("OrderRefundedBy", fields: [refundedByUserId], references: [id])
  parent             Order?                  @relation("OrderChildren", fields: [parentOrderId], references: [id], onDelete: SetNull)
  children           Order[]                 @relation("OrderChildren")
  transactions       Transaction[]
  resourceAccesses   ContactResourceAccess[]

  @@index([workspaceId, status])
  @@index([contactId])
  @@index([providerOrderId])
  @@index([parentOrderId])
}

model Transaction {
  id        String   @id @default(cuid())
  orderId   String
  type      TxType
  amount    Int // cents
  currency  String
  reference String? // Stripe charge_id
  status    TxStatus
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Subscription {
  id                   String  @id @default(cuid())
  workspaceId          String
  contactId            String
  funnelStepId         String?
  stepPricePlanId      String?
  orderBumpPricePlanId String?

  status          SubscriptionStatus
  paymentProvider String             @default("stripe")
  providerSubId   String // e.g. Stripe sub_xxx

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEnd           DateTime?
  planSnapshot       Json? // snapshot of plan at subscription creation time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id])
  funnelStep         FunnelStep?         @relation(fields: [funnelStepId], references: [id])
  // SetNull: merchant can hard-delete a plan even while a subscription is
  // active — planSnapshot has the name/amount/interval, providerSubId drives
  // renewal on the gateway side. Nothing here requires the plan row to exist.
  stepPricePlan      StepPricePlan?      @relation(fields: [stepPricePlanId], references: [id], onDelete: SetNull)
  orderBumpPricePlan OrderBumpPricePlan? @relation(fields: [orderBumpPricePlanId], references: [id], onDelete: SetNull)
  orders             Order[]

  @@index([workspaceId, status])
  @@index([providerSubId])
  @@index([contactId])
}

model ProcessedWebhookEvent {
  eventId     String // provider's event ID, e.g. Stripe evt_xxx
  workspaceId String
  provider    String
  processedAt DateTime @default(now())

  @@id([workspaceId, provider, eventId])
}

model Coupon {
  id          String    @id @default(cuid())
  workspaceId String
  code        String
  type        String // "percentage" | "fixed"
  discount    Int // percentage (0-100) for type=percentage, cents for type=fixed
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

// ─────────────────────────────────────────
// WORKSPACE SETTINGS (unified)
// ─────────────────────────────────────────

model WorkspaceSettings {
  workspaceId String @id
  // Each field is a JSONB blob — no migration needed when adding fields
  stripe      Json? // { publishableKey, secretKey, webhookSecret, mode }
  paypal      Json? // { clientId, clientSecret, webhookId, mode }
  smtp        Json? // { provider, host, port, username, password, maxPerDay }
  // NOTE: storage moved to Organization.storage (org-wide, single bucket
  // shared by every workspace under the org). Column dropped in migration
  // 20260524_drop_workspace_storage.
  ai          Json? // { provider, model, apiKey, enabled } — apiKey plaintext (same as stripe.secretKey pattern)
  emailFooter Json? // { customText?, physicalAddress? } — appended to every marketing email above the unsubscribe link

  // Set to true when the operator dismisses the onboarding checklist on the
  // dashboard. Independent column (not JSONB) so we can filter / count without
  // parsing JSON on every dashboard load.
  onboardingDismissed Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// AI ASSISTANT
// ─────────────────────────────────────────
// Per-user conversation with the workspace AI assistant. One conversation
// per user per workspace — each user has their own chat history. Cleared
// explicitly via /api/ai/clear.
model AiConversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String // FK without back-relation to keep User model untouched
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@unique([workspaceId, userId])
  @@index([workspaceId, userId])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  // role: "user" | "assistant" | "tool_use" | "tool_result"
  // - user: text from operator
  // - assistant: text from LLM (no tool call)
  // - tool_use: LLM proposes a tool call (content = { name, args })
  // - tool_result: outcome of executing the tool (content = result JSON)
  role           String
  content        Json
  // Set when role = tool_use. Tracks the lifecycle:
  //   pending_confirm → user must confirm (write tools)
  //   approved → user approved, server is executing
  //   rejected → user dismissed
  //   executed → ran successfully (paired tool_result follows)
  //   error → ran but failed (paired tool_result follows with error)
  // Read-only tools skip pending_confirm and go straight to executed.
  toolCallId     String?
  toolName       String?
  toolStatus     String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────
// RESOURCES
// ─────────────────────────────────────────

// Config: what a funnel step grants after purchase
model FunnelStepResource {
  id           String       @id @default(cuid())
  funnelStepId String
  type         ResourceType
  resourceId   String
  createdAt    DateTime     @default(now())

  funnelStep FunnelStep @relation(fields: [funnelStepId], references: [id], onDelete: Cascade)

  @@unique([funnelStepId, type, resourceId])
  @@index([type, resourceId]) // reverse lookup: "which steps currently grant resource X?"
}

// State: which contact has which access from which order (used for revoke)
model ContactResourceAccess {
  id          String       @id @default(cuid())
  workspaceId String
  contactId   String
  orderId     String
  type        ResourceType
  resourceId  String
  grantedAt   DateTime     @default(now())
  revokedAt   DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([contactId, type, resourceId, orderId])
  @@index([orderId]) // revoke: find all access entries for a single order
  @@index([contactId, type]) // check: does this contact have access to resource X?
}

// ─────────────────────────────────────────
// EMAIL TEMPLATES, BROADCASTS & SEND LOG
// ─────────────────────────────────────────

// Reusable email template — used by broadcasts, sequences, transactional sends.
// System templates (isSystem=true) are pre-seeded per workspace and cannot be deleted.
model EmailTemplate {
  id          String                @id @default(cuid())
  workspaceId String
  name        String
  subject     String
  htmlBody    String
  category    EmailTemplateCategory @default(MARKETING)

  isSystem  Boolean @default(false)
  systemKey String? // null for user templates; e.g. "order_confirmation"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  // No `EmailSend[]` back-relation — Pattern B uses generic sourceType/sourceId
  // without FK. Reverse-lookup sends with
  // `db.emailSend.findMany({ where: { sourceType: "TEMPLATE", sourceId: templateId } })`.

  @@unique([workspaceId, systemKey])
  @@index([workspaceId, category])
}

// One-time email campaign sent to all contacts or a tag-based audience.
model Broadcast {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  subject     String
  htmlBody    String
  templateId  String?
  fromName    String
  fromEmail   String

  status      BroadcastStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  // Targeting
  targetType   BroadcastTarget @default(ALL_CONTACTS)
  targetTagIds String[]        @default([])

  // Stats
  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  EmailTemplate? @relation(fields: [templateId], references: [id])

  // Note: no `EmailSend[]` back-relation under Pattern B. EmailSend's source is
  // generic (sourceType + sourceId without FK). Query sends with
  // `db.emailSend.findMany({ where: { sourceType: "BROADCAST", sourceId: broadcastId } })`.

  @@index([workspaceId, status])
  @@index([scheduledAt, status])
}

// Audit log of every email queued/sent — required for GDPR data export
// and basic per-contact email history.
model EmailSend {
  id          String  @id @default(cuid())
  workspaceId String
  contactId   String?
  toEmail     String

  // Generic source — Pattern B (snapshot at send time, no FK constraints).
  //   sourceType:  "BROADCAST" | "WORKFLOW" | "TEMPLATE" | "SYSTEM"
  //                String (not enum) so adding new source types stays additive
  //                — no migration, just an app-code enum bump.
  //   sourceId:    Raw ID of the source row (Broadcast.id / WorkflowEmail.id /
  //                EmailTemplate.id). NULL for SYSTEM sends. No FK constraint
  //                — source rows can rename / delete without touching sends.
  //                App code dispatches on sourceType when fresh source data is
  //                needed (preview re-render, navigation hrefs).
  //   sourceLabel: Human-readable label captured at send time. Survives source
  //                rename / delete — drives the "what was this from?" column
  //                in logs UI and audit-trail use cases.
  // Earlier schemas stored 3 FK columns (broadcastId/templateId/workflowEmailId)
  // + a `transactionalKey` string. Pattern B folds all of those into the 3
  // generic columns above.
  sourceType  String?
  sourceId    String?
  sourceLabel String?

  subject  String
  bodyHtml String? // Rendered HTML at send time. Snapshot for support / audit / debug.
  // Nullable for legacy rows; new sends always populate.
  status   EmailSendStatus @default(QUEUED)

  errorMessage      String?
  providerMessageId String? // SMTP Message-ID — used to correlate bounces

  queuedAt DateTime  @default(now())
  sentAt   DateTime?
  failedAt DateTime?

  // ─── Tracking ────────────────────────────────────────────────────────────
  // Populated by the open pixel + click redirect endpoints in the renderer.
  // openedAt/clickedAt capture the FIRST hit; *Count is total hits (a single
  // recipient may open/click multiple times). Workflow conditions
  // `email_opened` / `email_clicked` filter on `openedAt >= run.startedAt`
  // joined with `(sourceType, sourceId)` to scope to the configured source.
  openedAt   DateTime?
  openCount  Int       @default(0)
  clickedAt  DateTime?
  clickCount Int       @default(0)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  links     EmailSendLink[]

  @@index([workspaceId, status, queuedAt])
  @@index([workspaceId, sourceType, queuedAt]) // logs source filter
  @@index([contactId, queuedAt]) // contact email-history
  @@index([contactId, sourceType, sourceId, openedAt]) // workflow email_opened
  @@index([contactId, sourceType, sourceId, clickedAt]) // workflow email_clicked
  @@index([sourceType, sourceId]) // reverse: "all sends from source X"
}

// Per-link click tracking for outgoing emails. Each link in a rendered
// EmailSend.bodyHtml is replaced with a tracking redirect URL containing the
// `token` below; the renderer's click endpoint looks up the link, bumps
// clickedAt/clickCount, and 302-redirects to `url`.
model EmailSendLink {
  id          String @id @default(cuid())
  emailSendId String
  token       String @unique
  url         String @db.Text

  clickedAt  DateTime?
  clickCount Int       @default(0)

  emailSend EmailSend @relation(fields: [emailSendId], references: [id], onDelete: Cascade)

  @@index([emailSendId])
}

// ─────────────────────────────────────────
// AUTOMATIONS — Multi-action IF/THEN rules
// ─────────────────────────────────────────
//
// One trigger fires N actions in defined order. For example:
//   trigger:  NEW_SALE
//   actions:  [SEND_EMAIL "welcome", ADD_TAG "customer", WEBHOOK "notify slack"]
//
// Visual canvas builder (with branching/decision nodes) is a separate Phase 4 model.

// ─────────────────────────────────────────
// SENDER IDENTITIES
// ─────────────────────────────────────────
//
// Per-workspace list of "From" addresses that user can pick when composing
// broadcasts / automation emails / sequence steps. We do NOT verify these
// ourselves — the underlying SMTP provider (SES, SendGrid, Postmark, etc.)
// performs the real authentication. If the user picks an unauthorized
// address, the SMTP send fails and surfaces in EmailSend.errorMessage.

model SenderIdentity {
  id          String  @id @default(cuid())
  workspaceId String
  name        String // "Brand Support"
  email       String // "support@brand.com"
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

