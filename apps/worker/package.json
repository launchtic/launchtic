{
  "name": "@launchtic/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --external:*.node",
    "lint": "echo 'no lint configured'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@launchtic/database": "workspace:*",
    "@launchtic/email": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
