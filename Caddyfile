# ─── Initial / first-run Caddyfile ───────────────────────────────────────────
# Boots in HTTP-only "wizard mode" — listens on port 80 and proxies every
# request to the web app. Operator finishes setup at http://<server-ip>, which
# walks them through admin account + domain config. The wizard then PATCHes
# the full HTTPS config (this file's twin, dynamically generated) via Caddy's
# admin API on localhost:2019.
#
# After setup:
#   - Both APP_DOMAIN + PAGES_DOMAIN get auto-issued Let's Encrypt certs
#   - Custom funnel domains use on-demand TLS (Caddy calls web's /api/domains/check)
#   - Port 80 redirects to HTTPS
#
# DO NOT add domain blocks here — they're injected at runtime by the wizard.
# Editing this file by hand only affects the initial boot before setup.

{
	# Admin API on internal docker network port. NOT exposed to host.
	# Wizard's /api/setup/configure POSTs Caddy JSON config here to switch
	# from wizard-mode to production HTTPS.
	#
	# `origins` must include the docker service name `caddy` because that's
	# the Host header the web container sends (fetch `http://caddy:2019/...`).
	# Caddy's default origins list is loopback-only, so cross-container
	# requests are rejected with "client is not allowed to access from origin".
	admin :2019 {
		origins caddy caddy:2019 localhost 127.0.0.1
	}
}

# Reusable proxy block. Args:
#   {args[0]} — upstream (e.g. web:3000)
(proxy) {
	reverse_proxy {args[0]} {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_down Location ":[0-9]+" ""
	}
}

# Serve user uploads directly from disk (post-setup config will import this).
(uploads) {
	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}
}

# Wizard mode — every HTTP request goes to the web app. No HTTPS yet (no
# domain to request a cert for). Caddy switches to the post-setup config
# via admin API once the wizard finishes; this catch-all stops being used.
:80 {
	import uploads
	import proxy web:3000
}
